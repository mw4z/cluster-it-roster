# OpenWeatherMap API Key
WEATHER_API_KEY=your_api_key_here

# WhatsApp Bot Configuration
SESSION_NAME=cluster-it-support
GROUP_NAME=Cluster IT Support
SCHEDULE_CRON=00 7 * * *
STATE_CHECK_INTERVAL=600000

# Log Configuration
LOG_FILE=group_id_log.txt
MAX_LOG_SIZE_MB=5

# Web Dashboard
PORT=3000
# PIN for editing shifts and for uploading/removing roster files from the website.
# Roster uploads stay disabled until this is set.
ADMIN_PIN=
# Day of the month salary is paid
SALARY_DAY=27
# Where roster .xlsx files and dashboard edits live. On Render, point these at a
# persistent disk, otherwise uploads and edits are lost on every deploy.
ROSTER_DIR=./rosters
DATA_FILE=./data.json
# WhatsApp contacts (sender ID -> name). Copy contacts.example.json to start.
CONTACTS_FILE=contacts.json
